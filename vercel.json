{
    "version": 2,
    "maxDuration": 60,
    "builds": [
        { "src": "/api/index.php", "use": "vercel-php@0.9.0" },
        { "src": "/public/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_LOCALE": "ar",
        "APP_FALLBACK_LOCALE": "en",
        "ASSET_URL": "/",
        "SESSION_DRIVER": "database",
        "SESSION_SECURE_COOKIE": "false",
        "SESSION_CONNECTION": "pgsql",
        "CACHE_STORE": "database",
        "DB_CACHE_CONNECTION": "pgsql",
        "QUEUE_CONNECTION": "database",
        "DB_QUEUE_CONNECTION": "pgsql",
        "FILESYSTEM_DISK": "local",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "warning",
        "APP_CONFIG_CACHE": "/tmp/laravel/config.php",
        "APP_EVENTS_CACHE": "/tmp/laravel/events.php",
        "APP_PACKAGES_CACHE": "/tmp/laravel/packages.php",
        "APP_ROUTES_CACHE": "/tmp/laravel/routes.php",
        "APP_SERVICES_CACHE": "/tmp/laravel/services.php",
        "VIEW_COMPILED_PATH": "/tmp/laravel/framework/views"
    }
}
