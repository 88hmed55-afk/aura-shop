{
    "functions": {
        "server.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 3008,
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/favicon.ico", "dest": "/favicon.ico" },
        { "src": "/(.*)", "dest": "/server.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_LOCALE": "ar",
        "APP_FALLBACK_LOCALE": "en",
        "ASSET_URL": "/",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "false",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "local",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "warning",
        "APP_CONFIG_CACHE": "/tmp/laravel/config.php",
        "APP_EVENTS_CACHE": "/tmp/laravel/events.php",
        "APP_PACKAGES_CACHE": "/tmp/laravel/packages.php",
        "APP_ROUTES_CACHE": "/tmp/laravel/routes.php",
        "APP_SERVICES_CACHE": "/tmp/laravel/services.php",
        "VIEW_COMPILED_PATH": "/tmp/laravel/framework/views"
    }
}
